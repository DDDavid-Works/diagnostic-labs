<Window x:Class="DiagnosticLabs.LabResultsWindows.ClinicalChemistry2Window"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DiagnosticLabs.LabResultsWindows"
        xmlns:menu="clr-namespace:DiagnosticLabs.UserControls"
        mc:Ignorable="d"
        Title="Clinical Chemistry 2" Width="750" ShowInTaskbar="False"
        SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Background="#dfecdf" Loaded="Window_Loaded">
    <StackPanel Orientation="Vertical">
        <menu:MessagesUserControl></menu:MessagesUserControl>
        <menu:ActionToolbarUserControl x:Name="ActionToolbar" NewCommand="{Binding NewCommand}" SaveCommand="{Binding SaveCommand}" DeleteCommand="{Binding DeleteCommand}"
                                   SearchCommand="ActionToolbar_SearchCommand" PrintCommand="ActionToolbar_PrintCommand"
                                   SetDefaultsCommand="ActionToolbar_SetDefaultsCommand" SaveDefaultsCommand="ActionToolbar_SaveDefaultsCommand" CloseDefaultsCommand="ActionToolbar_CloseDefaultsCommand"></menu:ActionToolbarUserControl>
        <Grid Margin="0" VerticalAlignment="Top" Background="#ffffcc">
            <Grid.Resources>
                <Style TargetType="Label">
                    <Setter Property="Margin" Value="5" />
                    <Setter Property="Padding" Value="0,0,0,0" />
                    <Setter Property="HorizontalAlignment" Value="Right" />
                    <Setter Property="FontSize" Value="14" />
                </Style>
                <Style TargetType="TextBox">
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="Height" Value="22" />
                    <Setter Property="Width" Value="90" />
                    <Setter Property="FontSize" Value="14" />
                    <Setter Property="HorizontalContentAlignment" Value="Right" />
                </Style>
                <Style TargetType="Border">
                    <Setter Property="BorderBrush" Value="Black" />
                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                    <Setter Property="Margin" Value="0" />
                </Style>
            </Grid.Resources>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="120"></ColumnDefinition>
                <ColumnDefinition Width="100"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition></RowDefinition>
            </Grid.RowDefinitions>
            <Label Name="IdLabel" Content="Record Number:" Grid.Row="0" Grid.Column="1"></Label>
            <TextBox Name="IdTextBox" Grid.Row="0" Grid.Column="2" Text="{Binding ClinicalChemistry2.Id}" IsReadOnly="True" Margin="0,0,10,0"></TextBox>
            <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" />
        </Grid>
        <Grid Margin="10" VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="8*"></ColumnDefinition>
                <ColumnDefinition Width="2*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
            </Grid.RowDefinitions>
            <Grid.Resources>
                <Style TargetType="Label">
                    <Setter Property="Margin" Value="5,5,0,5" />
                    <Setter Property="Padding" Value="0,2,0,0" />
                    <Setter Property="HorizontalAlignment" Value="Left" />
                    <Setter Property="FontSize" Value="14" />
                </Style>
                <Style TargetType="TextBox">
                    <Setter Property="Margin" Value="0,5,5,5" />
                    <Setter Property="Height" Value="22" />
                    <Setter Property="FontSize" Value="14" />
                </Style>
                <Style TargetType="DatePicker">
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                    <Setter Property="Height" Value="22" />
                    <Setter Property="Margin" Value="0,5,5,5" />
                    <Setter Property="Padding" Value="0,0,0,0" />
                    <Setter Property="FontSize" Value="14" />
                </Style>
                <Style TargetType="Border">
                    <Setter Property="BorderBrush" Value="Black" />
                    <Setter Property="Margin" Value="0" />
                </Style>
            </Grid.Resources>
            <Grid Grid.Row="0" Grid.Column="0" VerticalAlignment="Top" Background="#efffef">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="11*"></ColumnDefinition>
                    <ColumnDefinition Width="15*"></ColumnDefinition>
                    <ColumnDefinition Width="1*"></ColumnDefinition>
                    <ColumnDefinition Width="6*"></ColumnDefinition>
                    <ColumnDefinition Width="15*"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition></RowDefinition>
                    <RowDefinition></RowDefinition>
                </Grid.RowDefinitions>
                <Border BorderThickness="1" Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" Grid.ColumnSpan="5" />
                <Label Name="PatientRegistrationCodeLabel" Content="Registration Code:" Grid.Row="0" Grid.Column="0"></Label>
                <menu:PatientRegistrationSearchByCodeUserControl Grid.Row="0" Grid.Column="1" Margin="0,5,5,0" x:Name="PatientRegistrationSearchByCode"></menu:PatientRegistrationSearchByCodeUserControl>
                <Label Name="InputRegDateLabel" Content="Registration Date:" Grid.Row="1" Grid.Column="0"></Label>
                <DatePicker Name="InputDateDatePicker" Grid.Row="1" Grid.Column="1" SelectedDate="{Binding PatientRegistration.InputDate}" IsEnabled="False"></DatePicker>
                <Label Name="CompanyNameLabel" Content="Company:" Grid.Row="0" Grid.Column="3"></Label>
                <TextBox Name="CompanyNameTextBox" Grid.Row="0" Grid.Column="4" Text="{Binding SelectedCompany.CompanyName}" IsReadOnly="True"></TextBox>
                <Label Name="BatchNameLabel" Content="Batch:" Grid.Row="1" Grid.Column="3"></Label>
                <TextBox Name="BatchNameTextBox" Grid.Row="1" Grid.Column="4" Text="{Binding SelectedBatchName}" IsReadOnly="True"></TextBox>
            </Grid>
            <Label Name="ClinicalChemistry2Label" Content="CLINICAL CHEMISTRY 2" Grid.Row="1" Grid.Column="0" FontSize="16" Margin="0,22,0,0"
               FontWeight="SemiBold" Padding="0,5,5,5" BorderThickness="0,0,0,2" BorderBrush="Black" VerticalAlignment="Top" HorizontalAlignment="Stretch"></Label>
            <StackPanel Grid.Row="0" Grid.Column="1" Grid.RowSpan="2" Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0">
                <Border BorderThickness="2" BorderBrush="Black" Margin="0" Height="120" Width="120" Padding="2">
                    <Image Name="Photo" Source="{Binding LogoImageSource}"></Image>
                </Border>
            </StackPanel>
        </Grid>
        <Grid Margin="10,10,10,0" VerticalAlignment="Top">
            <Grid.Resources>
                <Style TargetType="Label">
                    <Setter Property="Margin" Value="0,0,0,5" />
                    <Setter Property="Padding" Value="0,2,0,0" />
                    <Setter Property="HorizontalAlignment" Value="Left" />
                    <Setter Property="FontSize" Value="14" />
                </Style>
                <Style TargetType="TextBox">
                    <Setter Property="Margin" Value="0,0,0,5" />
                    <Setter Property="Height" Value="22" />
                    <Setter Property="FontSize" Value="14" />
                </Style>
                <Style TargetType="ComboBox">
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                    <Setter Property="Height" Value="22" />
                    <Setter Property="Padding" Value="2,0,0,0" />
                    <Setter Property="Margin" Value="0,0,0,5" />
                    <Setter Property="FontSize" Value="14" />
                    <Setter Property="IsEditable" Value="True" />
                    <Setter Property="IsTextSearchEnabled" Value="True" />
                </Style>
                <Style TargetType="DatePicker">
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                    <Setter Property="Height" Value="22" />
                    <Setter Property="Margin" Value="0,0,0,5" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="FontSize" Value="14" />
                </Style>
            </Grid.Resources>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="10*"></ColumnDefinition>
                <ColumnDefinition Width="15*"></ColumnDefinition>
                <ColumnDefinition Width="2*"></ColumnDefinition>
                <ColumnDefinition Width="8*"></ColumnDefinition>
                <ColumnDefinition Width="8*"></ColumnDefinition>
                <ColumnDefinition Width="2*"></ColumnDefinition>
                <ColumnDefinition Width="3*"></ColumnDefinition>
                <ColumnDefinition Width="5*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
            </Grid.RowDefinitions>
            <Label Name="PatientCodeLabel" Content="Patient Code:" Grid.Row="0" Grid.Column="0"></Label>
            <menu:PatientSearchByCodeUserControl Grid.Row="0" Grid.Column="1" x:Name="PatientSearchByCode"></menu:PatientSearchByCodeUserControl>
            <Label Name="PatientNameLabel" Content="Patient Name:" Grid.Row="1" Grid.Column="0"></Label>
            <menu:PatientSearchByNameUserControl Grid.Row="1" Grid.Column="1" x:Name="PatientSearchByName"></menu:PatientSearchByNameUserControl>
            <Label Name="CompanyOrPhysicianLabel" Content="Company/Physician:" Grid.Row="2" Grid.Column="0"></Label>
            <ComboBox Name="CompanyOrPhysicianTextBox" Grid.Row="2" Grid.Column="1" IsEditable="True" IsTextSearchEnabled="True" ItemsSource="{Binding CompanyOrPhysicians}" Text="{Binding ClinicalChemistry2.CompanyOrPhysician}"></ComboBox>
            <Label Name="AgeLabel" Content="Age:" Grid.Row="0" Grid.Column="3"></Label>
            <TextBox Name="AgeTextBox" Grid.Row="0" Grid.Column="4" Text="{Binding Patient.Age}"></TextBox>
            <Label Name="SexLabel" Content="Sex:" Grid.Row="0" Grid.Column="6"></Label>
            <ComboBox Name="SexTextBox" Grid.Row="0" Grid.Column="7" ItemsSource="{Binding Genders}" SelectedValue="{Binding Patient.Gender}"></ComboBox>
            <Label Name="DateRequestedLabel" Content="Date Requested:" Grid.Row="1" Grid.Column="3"></Label>
            <DatePicker Name="DateRequestedTextBox" Grid.Row="1" Grid.Column="4" SelectedDate="{Binding ClinicalChemistry2.DateRequested}"></DatePicker>
        </Grid>
        <Grid Margin="10,10,10,0" VerticalAlignment="Top">
            <Grid.Resources>
                <Style TargetType="Label">
                    <Setter Property="Margin" Value="5,5,0,5" />
                    <Setter Property="Padding" Value="0,2,0,0" />
                    <Setter Property="HorizontalAlignment" Value="Left" />
                    <Setter Property="FontSize" Value="14" />
                </Style>
                <Style TargetType="TextBox">
                    <Setter Property="Margin" Value="5,5,5,5" />
                    <Setter Property="Height" Value="22" />
                    <Setter Property="FontSize" Value="14" />
                </Style>
                <Style TargetType="Border">
                    <Setter Property="BorderBrush" Value="Black" />
                    <Setter Property="Margin" Value="0" />
                </Style>
            </Grid.Resources>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.2*"></ColumnDefinition>
                <ColumnDefinition Width="1.5*"></ColumnDefinition>
                <ColumnDefinition Width="1*"></ColumnDefinition>
                <ColumnDefinition Width="1.5*"></ColumnDefinition>
                <ColumnDefinition Width="1.5*"></ColumnDefinition>
                <ColumnDefinition Width="1*"></ColumnDefinition>
                <ColumnDefinition Width="1.5*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
            </Grid.RowDefinitions>
            <Border BorderThickness="1" Grid.Row="0" Grid.Column="0" Grid.RowSpan="5" Grid.ColumnSpan="7" />
            <Border BorderThickness="1,0,1,0" Grid.Row="1" Grid.Column="1" Grid.RowSpan="5" />
            <Border BorderThickness="1,0,1,0" Grid.Row="1" Grid.Column="3" Grid.RowSpan="5" />
            <Border BorderThickness="1,0,1,0" Grid.Row="1" Grid.Column="5" Grid.RowSpan="5" />

            <Border BorderThickness="0,1,0,1" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="7" />
            <Border BorderThickness="0,1,0,1" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="7" />
            <Border BorderThickness="0,0,1,1" Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" />
            
            <Label Name="TestHeaderLabel" Content="Test" Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"></Label>
            <Label Name="ConventionalLabel" Content="Conventional" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" FontWeight="Bold" HorizontalAlignment="Center"></Label>
            <Label Name="SystemUnitLabel" Content="System Unit" Grid.Row="0" Grid.Column="4" Grid.ColumnSpan="3" FontWeight="Bold" HorizontalAlignment="Center"></Label>

            <Label Name="NormalValueHeaderLabel" Content="Normal Value" Grid.Row="1" Grid.Column="1" FontWeight="Bold" HorizontalAlignment="Center"></Label>
            <Label Name="UnitHeaderLabel" Content="Unit" Grid.Row="1" Grid.Column="2" FontWeight="Bold" HorizontalAlignment="Center"></Label>
            <Label Name="ResultHeaderLabel" Content="Result" Grid.Row="1" Grid.Column="3" FontWeight="Bold" HorizontalAlignment="Center"></Label>

            <Label Name="NormalValueHeaderLabel2" Content="Normal Value" Grid.Row="1" Grid.Column="4" FontWeight="Bold" HorizontalAlignment="Center"></Label>
            <Label Name="UnitHeaderLabel2" Content="Unit" Grid.Row="1" Grid.Column="5" FontWeight="Bold" HorizontalAlignment="Center"></Label>
            <Label Name="ResultHeaderLabel2" Content="Result" Grid.Row="1" Grid.Column="6" FontWeight="Bold" HorizontalAlignment="Center"></Label>

            <Label Name="AlkalinePhosphataseLabel" Content="Alkaline Phosphatase" Grid.Row="2" Grid.Column="0"></Label>
            <Label Name="SGOTLabel" Content="SGOT" Grid.Row="4" Grid.Column="0"></Label>

            <TextBox Name="AlkalinePhosphataseCNValueTextBox" Grid.Row="2" Grid.Column="1" Text="{Binding ClinicalChemistry2.AlkalinePhosphataseCNValue}"></TextBox>
            <TextBox Name="AlkalinePhosphataseCUnitTextBox" Grid.Row="2" Grid.Column="2" Text="{Binding ClinicalChemistry2.AlkalinePhosphataseCUnit}"></TextBox>
            <TextBox Name="AlkalinePhosphataseCResultsTextBox" Grid.Row="2" Grid.Column="3" Text="{Binding ClinicalChemistry2.AlkalinePhosphataseCResults}"></TextBox>

            <TextBox Name="AlkalinePhosphataseSNValueTextBox" Grid.Row="2" Grid.Column="4" Text="{Binding ClinicalChemistry2.AlkalinePhosphataseSNValue}"></TextBox>
            <TextBox Name="AlkalinePhosphataseSUnitTextBox" Grid.Row="2" Grid.Column="5" Text="{Binding ClinicalChemistry2.AlkalinePhosphataseSUnit}"></TextBox>
            <TextBox Name="AlkalinePhosphataseSResultsTextBox" Grid.Row="2" Grid.Column="6" Text="{Binding ClinicalChemistry2.AlkalinePhosphataseSResults}"></TextBox>

            <TextBox Name="SGOTCNValueTextBox" Grid.Row="4" Grid.Column="1" Text="{Binding ClinicalChemistry2.SGOTCNValue}"></TextBox>
            <TextBox Name="SGOTCUnitTextBox" Grid.Row="4" Grid.Column="2" Text="{Binding ClinicalChemistry2.SGOTCUnit}"></TextBox>
            <TextBox Name="SGOTCResultsTextBox" Grid.Row="4" Grid.Column="3" Text="{Binding ClinicalChemistry2.SGOTCResults}"></TextBox>
            <TextBox Name="SGOTSNValueTextBox" Grid.Row="4" Grid.Column="4" Text="{Binding ClinicalChemistry2.SGOTSNValue}"></TextBox>
            <TextBox Name="SGOTSUnitTextBox" Grid.Row="4" Grid.Column="5" Text="{Binding ClinicalChemistry2.SGOTSUnit}"></TextBox>
            <TextBox Name="SGOTSResultsTextBox" Grid.Row="4" Grid.Column="6" Text="{Binding ClinicalChemistry2.SGOTSResults}"></TextBox>
        </Grid>
        <Grid Margin="10,0,10,10" VerticalAlignment="Top">
            <Grid.Resources>
                <Style TargetType="Label">
                    <Setter Property="Margin" Value="5,0,0,5" />
                    <Setter Property="Padding" Value="0,2,0,0" />
                    <Setter Property="HorizontalAlignment" Value="Center" />
                    <Setter Property="FontSize" Value="14" />
                </Style>
                <Style TargetType="ComboBox">
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                    <Setter Property="Height" Value="24" />
                    <Setter Property="Margin" Value="10,10,10,0" />
                    <Setter Property="Padding" Value="5,0,0,0" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="FontSize" Value="14" />
                </Style>
            </Grid.Resources>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="10*"></ColumnDefinition>
                <ColumnDefinition Width="10*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
            </Grid.RowDefinitions>
            <ComboBox Name="MedicalTechnologistComboBox" Grid.Row="0" Grid.Column="0" IsEditable="True" IsTextSearchEnabled="True"
                  ItemsSource="{Binding MedicalTechnologists}" SelectedValue="{Binding ClinicalChemistry2.MedicalTechnologist}" SelectionChanged="MedicalTechnologistComboBox_SelectionChanged"></ComboBox>
            <Label Name="MedicalTechnologistLabel" Content="Medical Technologist" Grid.Row="1" Grid.Column="0"></Label>
            <ComboBox Name="PathologistComboBox" Grid.Row="0" Grid.Column="1" IsEditable="True" IsTextSearchEnabled="True"
                  ItemsSource="{Binding Pathologists}" SelectedValue="{Binding ClinicalChemistry2.Pathologist}" SelectionChanged="PathologistComboBox_SelectionChanged"></ComboBox>
            <Label Name="PathologistLabel" Content="Pathologist" Grid.Row="1" Grid.Column="1"></Label>
        </Grid>
    </StackPanel>
</Window>
